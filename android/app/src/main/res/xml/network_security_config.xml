<?xml version="1.0" encoding="utf-8"?>
<!--
  Release builds talk to the gateway over HTTPS only. Debug builds override this file
  (app/src/debug/res/xml/network_security_config.xml) so a gateway on the local network can be
  used over plain http while developing.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
