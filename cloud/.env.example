# Copy to cloud/.env and replace every value with a unique random secret.
POLYCARE_ENROLLMENT_TOKEN=replace-with-at-least-32-random-characters
POLYCARE_TOKEN_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
POLYCARE_KNOWLEDGE_TOKEN=replace-with-a-third-random-secret-of-at-least-32-characters
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=replace-with-a-cluster-database-key
